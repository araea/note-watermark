<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jy.notewatermark"
    android:versionCode="8"
    android:versionName="3.0.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- The settings screen reaches the Notes app to trigger an export. -->
    <queries>
        <package android:name="com.coloros.note" />
    </queries>

    <!--
        Modern libxposed module (API 102): the entry class, scope and module
        properties live in META-INF/xposed/ inside the APK, so the legacy
        xposedmodule / xposeddescription / xposedminversion / xposedscope
        meta-data are gone.
    -->
    <application
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hasCode="true">

        <activity
            android:name=".ConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ConfigProvider"
            android:authorities="com.jy.notewatermark.settings"
            android:exported="true" />
    </application>
</manifest>
