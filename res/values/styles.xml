<resources>
    <style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:fontFamily">sans</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Sujian.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Sujian.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Sujian.Large</item>
    </style>

    <!-- Component shapes use the same rounded family as the launcher page. -->
    <style name="Shape.Sujian.Small" parent="ShapeAppearance.Material3.Corner.Small"><item name="cornerSize">12dp</item></style>
    <style name="Shape.Sujian.Medium" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSize">20dp</item></style>
    <style name="Shape.Sujian.Large" parent="ShapeAppearance.Material3.Corner.Large"><item name="cornerSize">28dp</item></style>
    <style name="Shape.Sujian.Pill" parent="ShapeAppearance.Material3.Corner.Full" />
    <style name="Shape.Sujian.Sheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Typography: five roles, nothing in between. -->
    <style name="Text.Sujian" parent="">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Text.Sujian.Section">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmallEmphasized</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Text.Sujian.Title">
        <item name="android:textAppearance">?attr/textAppearanceTitleMediumEmphasized</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Text.Sujian.Label">
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Text.Sujian.Body">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Text.Sujian.Caption">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Text.Sujian.PreviewLabel">
        <item name="android:textAppearance">?attr/textAppearanceLabelMediumEmphasized</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Components inherit the expressive defaults and only state what is specific. -->
    <style name="Widget.Sujian.StatusProgress" parent="Widget.Material3Expressive.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/status_progress_size</item>
        <item name="trackThickness">@dimen/status_progress_track</item>
    </style>
    <style name="Widget.Sujian.Segment" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="backgroundTint">@color/segment_container</item>
        <item name="android:textColor">@color/segment_label</item>
        <item name="iconTint">@color/segment_label</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:maxWidth">@null</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Widget.Sujian.Export" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:singleLine">false</item>
    </style>
</resources>
