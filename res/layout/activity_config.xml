<?xml version="1.0" encoding="utf-8"?>
<!--
    One screen, two tasks, laid out as the M3 Expressive segmented list Android's own
    settings use: grouped items on a surfaceContainer page, 2dp seams inside a group,
    a small primary header above each group.

    Status  - a single item: the module either works (quiet) or says what to do (loud).
    Share   - preview first, then the three outcomes as a radio list, then the text
              field when the custom line is chosen. The preview sits right above the
              control that changes it.
    Export  - a single item carrying the one filled button on the screen.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:focusableInTouchMode="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollColor="?attr/colorSurfaceContainerHigh">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            style="@style/Widget.Material3Expressive.CollapsingToolbar.Large"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:contentScrim="?attr/colorSurfaceContainerHigh"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:subtitle="@string/app_subtitle"
            app:title="@string/app_name">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.Material3Expressive.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="@dimen/page_gutter"
                android:paddingTop="@dimen/space_sm"
                android:paddingRight="@dimen/page_gutter"
                android:paddingBottom="@dimen/space_section">

                <!-- ============================================================ status -->
                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/statusItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.listitem.ListItemCardView
                        android:id="@+id/statusCard"
                        style="@style/Widget.Sujian.Segment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout style="@style/Widget.Sujian.SegmentRow">

                            <FrameLayout
                                android:layout_width="@dimen/list_leading"
                                android:layout_height="@dimen/list_leading"
                                android:importantForAccessibility="noHideDescendants">

                                <!-- An M3E shape carries the state glyph; its outline differs per state. -->
                                <ImageView
                                    android:id="@+id/statusIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/space_sm"
                                    android:visibility="gone" />

                                <com.google.android.material.loadingindicator.LoadingIndicator
                                    android:id="@+id/statusLoading"
                                    style="@style/Widget.Sujian.Loading"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </FrameLayout>

                            <LinearLayout
                                android:id="@+id/statusText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/space_lg"
                                android:layout_weight="1"
                                android:duplicateParentState="true"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statusTitle"
                                    style="@style/Widget.Sujian.Label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/statusDetail"
                                    style="@style/Widget.Sujian.Supporting"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/statusAction"
                                style="@style/Widget.Material3.ImageView.ListItem.TrailingIcon"
                                android:layout_width="@dimen/list_leading_glyph"
                                android:layout_height="@dimen/list_leading_glyph"
                                android:layout_marginLeft="@dimen/space_lg"
                                android:src="@drawable/ic_refresh" />
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>

                <!-- ============================================================= share -->
                <TextView
                    android:id="@+id/shareSection"
                    style="@style/Text.Sujian.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/space_lg"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingRight="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/share_section" />

                <LinearLayout
                    android:id="@+id/shareGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/segment_gap"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- The sheet mirrors the real share picture: note, then the footer row. -->
                    <com.google.android.material.listitem.ListItemLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.listitem.ListItemCardView
                            android:id="@+id/previewCard"
                            style="@style/Widget.Sujian.Segment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:contentPaddingBottom="@dimen/space_lg"
                            app:contentPaddingTop="@dimen/space_lg">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/previewLabel"
                                    style="@style/Widget.Sujian.Overline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/preview_label" />

                                <LinearLayout
                                    android:id="@+id/previewSheet"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_md"
                                    android:orientation="vertical"
                                    android:padding="@dimen/space_xl">

                                    <TextView
                                        android:id="@+id/sampleTitle"
                                        style="@style/Text.Sujian.Title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/preview_sample_title" />

                                    <TextView
                                        android:id="@+id/sampleBody"
                                        style="@style/Text.Sujian.Caption"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_sm"
                                        android:text="@string/preview_sample_body" />

                                    <LinearLayout
                                        android:id="@+id/previewFooter"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_xl"
                                        android:orientation="vertical">

                                        <View
                                            android:id="@+id/previewDivider"
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/hairline" />

                                        <TextView
                                            android:id="@+id/previewWatermark"
                                            style="@style/Text.Sujian.Caption"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/space_md"
                                            android:gravity="center" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/previewNote"
                                    style="@style/Text.Sujian.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_md"
                                    android:text="@string/preview_note" />
                            </LinearLayout>
                        </com.google.android.material.listitem.ListItemCardView>
                    </com.google.android.material.listitem.ListItemLayout>

                    <!-- Three outcomes, one radio list: every choice says what it does. -->
                    <com.google.android.material.listitem.ListItemLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.jy.notewatermark.ChoiceItem
                            android:id="@+id/modeHidden"
                            style="@style/Widget.Sujian.Segment.Choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout style="@style/Widget.Sujian.SegmentRow">

                                <RadioButton
                                    style="@style/Widget.Sujian.Radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/space_lg"
                                    android:layout_weight="1"
                                    android:duplicateParentState="true"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Widget.Sujian.Label"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_hidden" />

                                    <TextView
                                        style="@style/Widget.Sujian.Supporting"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_hidden_detail" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.jy.notewatermark.ChoiceItem>
                    </com.google.android.material.listitem.ListItemLayout>

                    <com.google.android.material.listitem.ListItemLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.jy.notewatermark.ChoiceItem
                            android:id="@+id/modeBlank"
                            style="@style/Widget.Sujian.Segment.Choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout style="@style/Widget.Sujian.SegmentRow">

                                <RadioButton
                                    style="@style/Widget.Sujian.Radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/space_lg"
                                    android:layout_weight="1"
                                    android:duplicateParentState="true"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Widget.Sujian.Label"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_blank" />

                                    <TextView
                                        style="@style/Widget.Sujian.Supporting"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_blank_detail" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.jy.notewatermark.ChoiceItem>
                    </com.google.android.material.listitem.ListItemLayout>

                    <com.google.android.material.listitem.ListItemLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.jy.notewatermark.ChoiceItem
                            android:id="@+id/modeCustom"
                            style="@style/Widget.Sujian.Segment.Choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout style="@style/Widget.Sujian.SegmentRow">

                                <RadioButton
                                    style="@style/Widget.Sujian.Radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/space_lg"
                                    android:layout_weight="1"
                                    android:duplicateParentState="true"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Widget.Sujian.Label"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_custom" />

                                    <TextView
                                        style="@style/Widget.Sujian.Supporting"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/mode_custom_detail" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.jy.notewatermark.ChoiceItem>
                    </com.google.android.material.listitem.ListItemLayout>

                    <com.google.android.material.listitem.ListItemLayout
                        android:id="@+id/inputItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <com.google.android.material.listitem.ListItemCardView
                            style="@style/Widget.Sujian.Segment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:contentPaddingBottom="@dimen/space_lg"
                            app:contentPaddingTop="@dimen/space_lg">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/inputLayout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/watermark_hint"
                                app:counterEnabled="true"
                                app:counterMaxLength="80"
                                app:endIconMode="clear_text"
                                app:helperText="@string/mode_custom_empty"
                                app:helperTextEnabled="true">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/watermarkInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionDone"
                                    android:inputType="text"
                                    android:saveEnabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.listitem.ListItemCardView>
                    </com.google.android.material.listitem.ListItemLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/applyHint"
                    style="@style/Text.Sujian.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/space_lg"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingRight="@dimen/space_lg"
                    android:text="@string/apply_hint" />

                <!-- ============================================================ export -->
                <TextView
                    android:id="@+id/exportSection"
                    style="@style/Text.Sujian.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/space_lg"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingRight="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/export_section" />

                <com.google.android.material.listitem.ListItemLayout
                    android:id="@+id/exportItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.listitem.ListItemCardView
                        style="@style/Widget.Sujian.Segment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:contentPaddingBottom="@dimen/space_lg"
                        app:contentPaddingTop="@dimen/space_lg">

                        <LinearLayout
                            android:id="@+id/exportContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/exportTitle"
                                style="@style/Widget.Sujian.Label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/export_title" />

                            <TextView
                                android:id="@+id/exportBody"
                                style="@style/Widget.Sujian.Supporting"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/export_body" />

                            <LinearLayout
                                android:id="@+id/exportPrivacyRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/exportPrivacyIcon"
                                    android:layout_width="@dimen/icon_inline"
                                    android:layout_height="@dimen/icon_inline"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_lock" />

                                <TextView
                                    android:id="@+id/exportPrivacy"
                                    style="@style/Text.Sujian.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/space_sm"
                                    android:text="@string/export_privacy" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/exportButton"
                                style="@style/Widget.Sujian.Export"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:text="@string/export_action"
                                app:icon="@drawable/ic_export" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/exportProgress"
                                style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md"
                                android:importantForAccessibility="no"
                                android:indeterminate="true"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/exportStatus"
                                style="@style/Text.Sujian.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.listitem.ListItemCardView>
                </com.google.android.material.listitem.ListItemLayout>

                <TextView
                    android:id="@+id/versionLabel"
                    style="@style/Text.Sujian.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_section"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
